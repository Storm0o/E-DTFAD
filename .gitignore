Dataset/BSDS500/
Dataset/Set12/
Dataset/BM3D test imgae/
Dataset/BSD300/
Dataset/Train400/
*.mat
*.h5
*.hdf5

# --- Large model weights ---
*.pth
*.pt

# --- Logs ---
*.log
logs/

# --- Temporary / generated files ---
*.tmp
*.bak
*.swp
*~
Thumbs.db
.DS_Store
desktop.ini

# --- Large generated archives (keep the .tex source, not the zip) ---
DTFAD_IEEE_LaTeX_Package.zip
DTFAD_LaTeX_Report_Package.zip
latex_report.zip

# --- Large Word / intermediate docs (keep the PDF and LaTeX) ---
DTFAD_Final_Comprehensive_Comparison_Report.docx
DTFAD_Enhancements_Mathematical_Analysis.docx

# --- LaTeX build artifacts ---
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lot
*.lof

